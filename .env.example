# =====================================================================
# Inkloom AI: Database & Security Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. PostgreSQL / Supabase Database Connection
# ---------------------------------------------------------------------
# Direct or connection-pooled PostgreSQL URL:
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# Supabase API (Optional if using direct PostgreSQL DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------------
# 2. JWT Authentication & Password Hashing
# ---------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_brand_governance_key_2026
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------
# 3. Optional Standalone Backend Service (Render / Local Express)
# ---------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

