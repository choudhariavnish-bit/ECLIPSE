# =====================================================================
# Inkloom Brand Governance Backend Environment Variables
# =====================================================================

PORT=5000
NODE_ENV=production

# ---------------------------------------------------------------------
# PostgreSQL / Supabase Database Connection
# Option A: Direct PostgreSQL URI (Render PostgreSQL, Supabase direct or pooler)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Supabase Cloud API Keys (Optional if using direct DATABASE_URL)
# ---------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------
# Authentication & Security
# ---------------------------------------------------------------------
JWT_SECRET=super_strong_brand_governance_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# Zero Data Retention & AI Calibration
# ---------------------------------------------------------------------
ZERO_DATA_RETENTION=true
CORS_ORIGIN=http://localhost:3000,https://YOUR-APP.onrender.com

